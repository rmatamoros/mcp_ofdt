# Copiar a mcp/.env (ignorado por git) y completar.
# Raiz ORDS del esquema: el token esta en /oauth/token y la API en /api/v1/
OFDT_BASE_URL=https://<host>/ords/ofdt
# Cliente OAuth2 creado con OFDT_API.CREATE_CLIENT (ver docs/api-rest.md)
OFDT_CLIENT_ID=
OFDT_CLIENT_SECRET=
# stdio (default) o http
MCP_TRANSPORT=stdio
PORT=3000
# Directorio desde el que upload_module/import_catalog_txt pueden leer archivos
OFDT_DATA_DIR=/data
